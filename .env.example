# Copiar a .env y ajustar. Los valores por defecto sirven para desarrollo local.

# --- Contenedor PostGIS ---
POSTGRES_DB=gps_flota
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev

# --- Conexión desde Python ---
DB_HOST=localhost
DB_PORT=5432

# --- Usuarios de aplicación (mínimo privilegio) ---
APP_INGEST_PASSWORD=ingest_dev
APP_ETL_PASSWORD=etl_dev
APP_ANALYST_PASSWORD=analyst_dev
APP_ADMIN_PASSWORD=admin_dev

# --- API (header X-API-Key) ---
API_KEY_INGEST=dev-ingest-key
API_KEY_ANALYST=dev-analyst-key
API_KEY_ADMIN=dev-admin-key
# URL de la API que usa el simulador del tablero
API_URL=http://localhost:8000
